# Copy this file to .env beside Test-RdsSqlServerPrerequisites.ps1.
# Replace every example value. Never commit or share the real .env file.
# Run-RdsSqlServerCheck.bat deletes the temporary .env after a run.
# Only lines beginning with # are comments. Values are read literally, not as shell commands.
# Surround a value with single or double quotes when it contains leading/trailing spaces.
RDS_ENDPOINT=example.abc123.ap-northeast-1.rds.amazonaws.com
RDS_PORT=1433
RDS_DATABASE=your_database
SQL_USERNAME=your_sql_login
SQL_PASSWORD=replace-with-your-password
